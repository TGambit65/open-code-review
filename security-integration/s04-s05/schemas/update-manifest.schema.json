{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved immutable offline update set",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "kind": {
      "enum": [
        "approved-offline-update-set"
      ]
    },
    "set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "approval_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_set_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "adapter": {
            "enum": [
              "ocr",
              "opengrep",
              "gitleaks",
              "osv"
            ]
          },
          "kind": {
            "enum": [
              "binary",
              "rules",
              "database",
              "policy"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967296
          },
          "verification_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dataset": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "adapter",
          "kind",
          "version",
          "source_commit",
          "sha256",
          "bytes",
          "verification_receipt_sha256",
          "provenance_sha256",
          "license_receipt_sha256",
          "dataset",
          "created_at",
          "expires_at"
        ]
      },
      "maxItems": 256,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "set_id",
    "approved_at",
    "approval_receipt_sha256",
    "previous_set_sha256",
    "assets"
  ],
  "$comment": "Documentation schema only. Runtime uses bounded local validators; no remote schema resolution or fetch."
}
